{
  "prefix": "/etc/$APP_NAME/",
  "locale": "en_US.UTF-8",
  "log": {
    "level": "debug",
    "file": "logs/error.log",
    "access": "logs/access.log",
    "postgres": "logs/postgres.log"
  },
  "daemon": {
    "enabled": false,
    "pid": "logs/$APP_NAME.pid",
    "lock": "logs/$APP_NAME.lock"
  },
  "process": {
    "master": false,
    "helper": false,
    "user": "",
    "group": ""
  },
  "workers": 1,
  "server": {
    "listen": "127.0.0.1",
    "port": 4977,
    "backlog": 128,
    "timeout": 5000,
    "root": "www"
  },
  "module": {
    "heartbeat": {
      "enable": true
    },
    "WebService": {
      "enable": true
    }
  },
  "postgres": {
    "connect": false,
    "notice": false,
    "timeout": 10,
    "worker": {
      "host": "",
      "port": "5432",
      "dbname": "",
      "user": "daemon",
      "password": "",
      "sslmode": "disable"
    },
    "pool": {
      "min": 5,
      "max": 10
    }
  }
}
